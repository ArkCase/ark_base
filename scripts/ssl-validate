#!/bin/bash
#
# Validates the SSL files that ssl-init rendered, as described by the SSL environment
# file. The certificate and its trusts are validated by test-certificate, and then
# what's particular to how we render them.
#

set -euo pipefail
. /.functions

set_or_default SSL_DIR "/.ssl"

require_exe openssl

# This also loads the SSL environment file
wait_ssl

# Hand over whichever of the files are configured
[ -n "${SSL_CERTIFICATE:-}" ] || fail "There's no certificate to validate (SSL_CERTIFICATE isn't set)"
is_file_readable "${SSL_CERTIFICATE}" || fail "The file [${SSL_CERTIFICATE}] given in SSL_CERTIFICATE isn't readable"
ARGS=()
MAP=(
	--key:SSL_PRIVATE_KEY
	--chain:SSL_CA_CHAIN
	--root:SSL_CA_ROOT
)
for PAIR in "${MAP[@]}" ; do
	FLAG="${PAIR%%:*}"
	VAR="${PAIR#*:}"
	[ -v "${VAR}" ] || continue
	VAL="${!VAR}"
	is_file_readable "${VAL}" || fail "The file [${VAL}] given in ${VAR} isn't readable"
	ARGS+=( "${FLAG}" "${VAL}" )
done
test-certificate "${ARGS[@]}" -- "${SSL_CERTIFICATE}" || exit ${?}

# Is the CA that issued our certificate in the system trusts?
SSL_DIRECTORIES="$(find-ssl-dirs)" || fail "Failed to compute the local SSL configuration"
source <(echo -n "${SSL_DIRECTORIES}") || fail "Failed to apply the local SSL configuration"

# Verify the certificate using only the system's trusts as anchors. The certificate
# file also carries the intermediates, so it's used to build the chain. This way the
# issuers are matched by their signatures, so subject hash collisions don't matter
OUT="$(openssl verify -no-CApath -no-CAstore -CAfile "${OS_SSL_CA_TRUSTS}" -untrusted "${SSL_CA_INT:-${SSL_CERTIFICATE}}" "${SSL_CERTIFICATE}" 2>&1)" || fail "The CA that issued the certificate [${SSL_CERTIFICATE}] isn't in the system's trusts at [${OS_SSL_CA_TRUSTS}] (rc=${?}): ${OUT}"

# The encrypted key must be the same key
if [ -n "${SSL_PRIVATE_KEY_ENCRYPTED:-}" ] ; then
	PUBLIC_FROM_PLAIN="$(openssl pkey -pubout -passin "pass:" -in "${SSL_PRIVATE_KEY}" 2>&1)" || fail "Failed to read the private key [${SSL_PRIVATE_KEY}] (rc=${?}): ${PUBLIC_FROM_PLAIN}"
	PUBLIC_FROM_ENCRYPTED="$(openssl pkey -pubout -passin "file:${SSL_PASSWORD_FILE}" -in "${SSL_PRIVATE_KEY_ENCRYPTED}" 2>&1)" || fail "Failed to decrypt the private key [${SSL_PRIVATE_KEY_ENCRYPTED}] (rc=${?}): ${PUBLIC_FROM_ENCRYPTED}"
	[ "${PUBLIC_FROM_ENCRYPTED}" == "${PUBLIC_FROM_PLAIN}" ] || fail "The encrypted private key [${SSL_PRIVATE_KEY_ENCRYPTED}] isn't the same key as [${SSL_PRIVATE_KEY}]"
	ok "The encrypted private key is the same key"
fi

ok "SSL validation complete!"
exit 0
