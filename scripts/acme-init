#!/bin/bash
[ $(id -u) -eq 0 ] || exec sudo --non-interactive "${0}" "${@}"

set -euo pipefail

. /.functions
export LOCK="$(readlink -f "${0}")"

SSL_DIRECTORIES="$(find-ssl-dirs)" || fail "Failed to compute the local SSL configuration"
source <(echo -n "${SSL_DIRECTORIES}") || fail "Failed to apply the local SSL configuration"

# Everything we create is only accessible by root, until relax_permissions
# hands it over to its consumers. This way there's never a window during
# which any sensitive files may be read by anyone else
umask 0077

#
# Make sure we set our global cURL flags
#
export CURL_HOME="/etc/curl"

#
# Set some defaults
#
set_or_default BASE_DIR "/app"
set_or_default FIPS_DIR "${BASE_DIR}/fips"

export DEFAULT_JAVA_SSL_KEYSTORE_TYPE="BCFKS"
export DEFAULT_JAVA_SSL_KEYSTORE_PROVIDER="BCFIPS"
export DEFAULT_JAVA_SSL_KEYSTORE_PROVIDER_CLASS="org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider"
export DEFAULT_JAVA_SSL_KEYSTORE_PROVIDER_PATH="${FIPS_DIR}"

export DEFAULT_JAVA_GLOBAL_TRUSTSTORE_TYPE="JKS"
export DEFAULT_JAVA_GLOBAL_TRUSTSTORE="${OS_SSL_JAVA_CACERTS}"
export DEFAULT_JAVA_GLOBAL_TRUSTSTORE_PASSWORD="changeit"
export DEFAULT_JAVA_GLOBAL_TRUSTSTORE_PROVIDER="SUN"
export DEFAULT_JAVA_GLOBAL_TRUSTSTORE_PROVIDER_CLASS="sun.security.provider.Sun"

# Just for safety's sake
cd /

split_hostnames()
{
	if [ ${#} -gt 0 ] ; then
		echo "${@}" | split_hostnames
	else
		# The values may be separated by commas, colons, or whitespace
		tr ',:[:space:]' '\n' | sed -e '/^\s*$/d'
	fi
	return 0
}

list_hostname_variations()
{
	local VARIATION="${1}"
	shift

	echo "${VARIATION}"
	get_service_ip "${VARIATION}"

	for n in "${@}" ; do
		# We stop as soon as we find an empty element
		[ -n "${n}" ] || break

		VARIATION+=".${n}"
		echo "${VARIATION}"
	done
}

get_service_ip()
{
	# Sanitize the name - convert all invalid chars to "_"
	local SERVICE_NAME="$(echo -n "${1^^}" | tr -c '[A-Z0-9]' '_')"
	local SVC_VAR="${SERVICE_NAME^^}_SERVICE_HOST"
	[ -v "${SVC_VAR}" ] || return 0
	local SVC_IP=""
	SVC_IP="$(validate_ip "${!SVC_VAR}")" || return 0
	[ "${SVC_IP}" != "127.0.0.1" ] && echo "${SVC_IP}"
	return 0
}

marker_exists()
{
	local MARKER="${1}"
	is_file "${MARKER}" || return 1
	[ -s "${MARKER}" ] || return 1
	return 0
}

stop_watching()
{
	if [ -n "${WATCHER:-}" ] ; then
		# Reap it as well, so it doesn't linger as a zombie
		kill "${WATCHER}" &>/dev/null || true
		wait "${WATCHER}" &>/dev/null || true
	fi
	[ -n "${WATCH_FD:-}" ] && exec {WATCH_FD}<&-
	WATCHER=""
	WATCH_FD=""
	return 0
}

wait_for_marker()
{
	local MARKER="${1}"
	local TIMEOUT=""
	TIMEOUT="$(timestr_to_secs "${2}")" || fail "Invalid timeout specification [${2}]"

	local TIMEOUT_STR="$(secs_to_timestr "${TIMEOUT}")"
	local DIR="$(dirname "${MARKER}")"

	local START="$(date +%s)"
	local NOW=""
	local LEFT=""
	local LINE=""
	local RC=""
	WATCHER=""
	WATCH_FD=""

	if ! marker_exists "${MARKER}" ; then
		flock -u 999 || fail "Failed to release the execution lock for SSL initialization"
		waiting "Waiting for the ACME certificates to be initialized (up to ${TIMEOUT_STR} total)..."

		# Watch the directory for as long as we wait, so no changes are missed. The marker
		# may be moved into place, or created and written in place (it's created empty, so
		# the write is what we're really after). Other changes just wake us up early.
		exec {WATCH_FD}< <(exec inotifywait -m -e moved_to -e create -e close_write --format '%f' "${DIR}" 2>&1)
		WATCHER="${!}"

		# Don't look for the marker until the watch is in place, or we could miss it
		while read -t 5 -u "${WATCH_FD}" LINE ; do
			[ "${LINE}" != "Watches established." ] || break
		done
	fi

	while ! marker_exists "${MARKER}" ; do
		# If the timeout has expired, return a non-zero value
		NOW="$(date +%s)"
		LEFT=$(( TIMEOUT - (NOW - START) ))
		if [ ${LEFT} -le 0 ] ; then
			stop_watching
			return 1
		fi
		[ ${LEFT} -le 5 ] || LEFT=5

		if [ -n "${WATCH_FD}" ] ; then
			RC=0
			read -t "${LEFT}" -u "${WATCH_FD}" LINE || RC=${?}

			# 0 = something happened, > 128 = timed out ... anything else means the watch
			# is gone (i.e. the directory doesn't exist), so fall back to polling
			[ ${RC} -eq 0 ] || [ ${RC} -gt 128 ] || stop_watching
		else
			sleep 1 || fail "Sleep interrupted"
		fi
	done
	stop_watching
	ok "The ACME client is initialized and ready"
	return 0
}

is_valid_url()
{
	local URL="${1}"
	[[ "${URL}" =~ ^([^:/?#]+)://([^/?#]*)?([^?#]*)([?]([^#]*))?(#(.*))?$ ]] || return 1
	return 0
}

validate_ip()
{
	[ ${#} -ge 1 ] || return 1
	local PARTS=()
	for IP in "${@}" ; do
		is_valid_ipv4 "${IP}" || return 1
		echo "${IP}"
	done
	return 0
}

validate_cert()
{
	local CERT="${1}"
	is_file_readable "${CERT}" || return 1
	[ -s "${CERT}" ] || return 1
	openssl x509 -noout -text -in "${CERT}" &>/dev/null || return ${?}
	return 0
}

is_ca()
{
	local CERT="${1}"
	validate_cert "${CERT}" || return ${?}
	# Is the certificate a CA certificate of some kind?
	openssl x509 -noout -ext basicConstraints -in "${CERT}" 2>/dev/null | \
		tail -n +2 | \
		sed -e 's;, ;\n;g' -e 's;^\s*;;g' | \
		grep -qi "^CA:TRUE" || return ${?}
	return 0
}

install_chain()
{
	local CERT_BASE_NAME="${1}"
	local SUFFIX="${2}"
	local EXT="${SUFFIX:+.}${SUFFIX}"
	local DEST=""
	DEST="$(mktemp -d)" || return ${?}

	# Split each certificate into its own file, ignoring everything else
	# (i.e. comments, openssl s_client's output, DOS line endings, etc.)
	local RC=0
	awk -v DEST="${DEST}" '
		{ sub(/\r$/, "") }
		/^-+BEGIN CERTIFICATE-+$/ { FILE = sprintf("%s/xx%02d", DEST, ++N) }
		FILE { print > FILE }
		/^-+END CERTIFICATE-+$/ { if (FILE) close(FILE) ; FILE = "" }
	' || RC=${?}

	local COUNT=0
	local n=""
	while [ ${RC} -eq 0 ] && read n ; do
		# Only CA certificates are trusted, never individual server certificates
		is_ca "${n}" || continue

		local SUBJECT="$(openssl x509 -noout -subject -in "${n}" | sed -e 's;^subject=;;g')"
		local ISSUER="$(openssl x509 -noout -issuer -in "${n}" | sed -e 's;^issuer=;;g')"
		say "Installing certificate: ${SUBJECT}"
		[ "${SUBJECT}" != "${ISSUER}" ] && say "Issued by: ${ISSUER}"
		mv -f "${n}" "${CERT_BASE_NAME}.${n##*/}${EXT}" || RC=${?}
		COUNT=$(( COUNT + 1 ))
	done < <(find "${DEST}" -mindepth 1 -maxdepth 1 -type f -name 'xx*' | sort)
	rm -rf "${DEST}"

	[ ${RC} -eq 0 ] || return ${RC}
	[ ${COUNT} -gt 0 ] || warn "No CA certificates were found, so none were installed"
	return 0
}

download_from_port()
{
	local HOST="${1}"
	local SNI="${2}"
	local PORT="${3}"
	local PROTOCOL="${4}"
	local TARGET="${5}"
	local SUFFIX="${6}"

	local SNI_FLAGS=()
	[ -n "${SNI}" ] && SNI_FLAGS+=( -servername "${SNI}" )

	local TLS_FLAGS=()
	if [ -n "${PROTOCOL}" ] ; then
		TLS_FLAGS+=( -starttls "${PROTOCOL}" )
		[ -n "${SNI}" ]  && TLS_FLAGS+=( -name "${SNI}" )
		PROTOCOL=":${PROTOCOL}"
	fi

	local CERT_BASE_NAME="${SNI}"
	[ -n "${CERT_BASE_NAME}" ] && CERT_BASE_NAME+="@"
	CERT_BASE_NAME+="${HOST}:${PORT}${PROTOCOL}"

	# install_chain ignores everything that isn't a certificate, so the
	# error output can be safely captured along with the certificates
	local CHAIN=""
	CHAIN="$(openssl s_client -connect "${HOST}:${PORT}" \
		"${SNI_FLAGS[@]}" "${TLS_FLAGS[@]}" \
		-showcerts </dev/null 2>&1)" || { local RC=${?} ; err "Failed to get the certificates from [${HOST}:${PORT}] (rc=${RC}):\n${CHAIN}" ; return ${RC} ; }
	install_chain "${TARGET}/${CERT_BASE_NAME}" "${SUFFIX}" <<< "${CHAIN}"
}

download_chain()
{
	local CERT_BASE_NAME="${1}"
	local URL="${2}"
	local SUFFIX="${3}"
	local CHAIN=""
	CHAIN="$(curl -kL --fail --silent --show-error --connect-timeout 5 "${URL}" 2>&1)" || { local RC=${?} ; err "Failed to download the certificates from [${URL}] (rc=${RC}):\n${CHAIN}" ; return ${RC} ; }
	install_chain "${CERT_BASE_NAME}" "${SUFFIX}" <<< "${CHAIN}"
}

expand_vars()
{
	echo -n "${@}" | envsubst
}

await_if_necessary()
{
	set_or_default ACME_WAIT "false"
	if as_boolean "${ACME_WAIT}" ; then
		set_or_default ACME_WAIT_TIMEOUT "20m"
		wait_for_marker "${SSL_ENV_FILE}" "${ACME_WAIT_TIMEOUT}" || fail "ACME client initialization timed out"
		quit "ACME rendering is complete, you can load the necessary variables from [${SSL_ENV_FILE}]"
	fi
	return 0
}

download_issuer_trusts()
{
	set_or_default ACME_URL "https://acme:9000"
	# Validate the URL
	[[ "${ACME_URL}" =~ ^http(s)?://([^:/]+)(:([1-9][0-9]*))?(/.*)?$ ]] || fail "Malformed URL for the ACME CA: [${ACME_URL}]"

	ACME_HOST="${BASH_REMATCH[2]}"
	ACME_PORT="80"
	[ -z "${BASH_REMATCH[1]}" ] || ACME_PORT="443"
	[ -z "${BASH_REMATCH[4]}" ] || ACME_PORT="${BASH_REMATCH[4]}"

	# Validate the values captured above ... must have a valid host and port
	is_valid_hostname "${ACME_HOST}" || fail "Malformed URL for the ACME CA: bad hostname [${ACME_URL}]"
	is_valid_port "${ACME_PORT}" || fail "The port in the URL must be between 1 and 65535"

	ACME_ROOT_CA_BASENAME="ca-root"
	ACME_ROOT_CA_ANCHOR="${OS_SSL_ANCHORS}/${ACME_ROOT_CA_BASENAME}.${OS_SSL_SUFFIX}"

	#
	# Ok ... start working our magic!
	#

	################################################################################
	#
	# Download the root CA we'll use to trust everything from this cluster
	#
	################################################################################

	# Wait up to 5 minutes for the CA to come up
	MAX_WAIT=300
	START="$(date +%s)"
	say "🏛️ Fetching the root CA certificate from [${ACME_HOST}]"
	while true ; do
		# TODO: What's the standard way to do this in ACME-land?
		OUT="$(curl -k -fsSL -o "${ACME_ROOT_CA_ANCHOR}" "${ACME_URL}/roots.pem" 2>&1)" && break
		err "Failed to get the step root CA (rc=${?}):\n${OUT}"
		NOW="$(date +%s)"
		[ $(( NOW - START )) -ge ${MAX_WAIT} ] && fail "Timed out trying to reach the CA issuer at [${ACME_URL}]"
		sleep 5 || fail "Sleep interrupted trying to wait for [${ACME_URL}] - cannot continue"
	done
	ok "Fetch OK!"

	################################################################################
	#
	# Initialize the ACME client
	#
	################################################################################
	if step ca health &>/dev/null ; then
		ok "Step CA client already initialized!"
	else
		say "🛡️ Initializing the Step CA Acme Client"
		step ca bootstrap -f \
			--ca-url "${ACME_URL}" \
			--fingerprint "$(step certificate fingerprint "${ACME_ROOT_CA_ANCHOR}")"
		ok "Done!"
	fi

	########################################
	# Copy the CA's certs into the SSL_DIR
	########################################
	say "💾 Copying the root CA into the target directory..."
	cp -f "${ACME_ROOT_CA_ANCHOR}" "${SSL_CA_ROOT}"
	PUBLIC_FILES+=( "${SSL_CA_ROOT}" )
	ok "Done!"
}

download_trusts()
{
	################################################################################
	#
	# Trust the certificates we're told to trust
	#
	################################################################################
	say "🔧 Deploying the common trusted certificates from [${SSL_TRUSTS_DIR}]"
	is_dir_writable "${SSL_TRUSTS_DIR}" || mkdir -p "${SSL_TRUSTS_DIR}"
	SSL_TRUSTS_DIR="$(readlink -f "${SSL_TRUSTS_DIR}")"

	COUNT=0

	set_or_default K8S_CA "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	if is_file_readable "${K8S_CA}" ; then
		say "Deploying the local Kubernetes cluster's CA certificate ..."
		install_chain "${OS_SSL_ANCHORS}/kubernetes-ca" "${OS_SSL_SUFFIX}" < "${K8S_CA}" || fail "Failed to deploy the Kubernetes CA certificate from [${K8S_CA}]"
		(( ++COUNT ))
	fi

	while read cert ; do
		CERT="${cert##*/}"
		if [ ! -f "${cert}" ] ; then
			warn "The certificate [${CERT}] is not a regular file, skipping"
			continue
		fi

		case "${CERT,,}" in
			# If the data is an actual certificate, copy it verbatim
			*.pem | *.crt )
				say "Deploying certificate [${CERT}]..."
				install_chain "${OS_SSL_ANCHORS}/${CERT%.*}" "${OS_SSL_SUFFIX}" < "${cert}" || fail "Failed to deploy the certificate [${CERT}]"
				;;

			# If the data is a URL, then try to pull it down and put the resulting file into
			# the correct location using ${CERT} as the name
			*.url )
				STR="$(<"${cert}")"
				URL="$(expand_vars "${STR}" 2>&1)" || { warn "Failed to expand the environment variables contained in [${STR}] (rc=${?}): ${URL}" ; continue ; }
				is_valid_url "${URL}" || fail "The certificate [${CERT}] is invalid - the URL syntax is invalid: [${URL}]"
				say "Downloading the certificate [${CERT}] from [${URL}]..."
				download_chain "${OS_SSL_ANCHORS}/${CERT%.*}" "${URL}" "${OS_SSL_SUFFIX}" || fail "Failed to download the certificate [${CERT}] from the URL [${URL}]"
				;;

			*.ssl )
				STR="$(<"${cert}")"
				SERVER="$(expand_vars "${STR}" 2>&1)" || { warn "Failed to expand the environment variables contained in [${STR}] (rc=${?}): ${SERVER}" ; continue ; }
				[[ "${SERVER}" =~ ^(([^@]+)@)?(([^:]+):([0-9]+))(/(.*))?$ ]] || fail "The certificate [${CERT}] is invalid - the server string [${SERVER}] did not match the required pattern ([serverName@]hostNameOrIP:port[/tls-protocol])"
				SERVER_NAME="${BASH_REMATCH[2]}"
				HOST_NAME="${BASH_REMATCH[4]}"
				PORT="${BASH_REMATCH[5]}"
				TLS_PROTOCOL_STR="${BASH_REMATCH[6]}"
				TLS_PROTOCOL="${BASH_REMATCH[7],,}"
				if [ -n "${SERVER_NAME}" ] ; then
					is_valid_hostname "${SERVER_NAME}" || fail "Invalid server name [${SERVER_NAME}] in spec [${SERVER}] from [${CERT}]"
				fi
				is_valid_hostname "${HOST_NAME}" || fail "Invalid host name [${HOST_NAME}] in spec: [${SERVER}] from [${CERT}]"
				is_valid_port "${PORT}" || fail "Invalid port number [${PORT}] in spec: [${SERVER}] from [${CERT}]"
				DESCRIPTION="SSL server [${SERVER}]"
				if [ -n "${TLS_PROTOCOL_STR}" ] ; then
					case "${TLS_PROTOCOL}" in
						ftp | imap | irc | ldap | lmtp | mysql | nntp | pop3 | postgres | sieve | smtp | xmpp | xmpp-server ) ;;
						* ) fail "Unsupported TLS protocol [${TLS_PROTOCOL}]" ;;
					esac
					DESCRIPTION="TLS server [${SERVER}] (${TLS_PROTOCOL})"
				fi
				say "Downloading the certificate [${CERT}] from the ${DESCRIPTION} ..."
				download_from_port "${HOST_NAME}" "${SERVER_NAME}" "${PORT}" "${TLS_PROTOCOL}" "${OS_SSL_ANCHORS}" "${OS_SSL_SUFFIX}" || fail "Failed to download the certificate from the ${DESCRIPTION} as requested by [${CERT}]"
				;;

			* )
				warn "Don't know how to handle certificate [${CERT}], skipping"
				continue
				;;
		esac

		(( ++COUNT ))
	done < <(find "${SSL_TRUSTS_DIR}" -mindepth 1 -maxdepth 1 -name "ssl-trust-*.*" | sort)
	if [ ${COUNT} -eq 0 ] ; then
		ok "No certificates to deploy."
	else
		ok "Deployed ${COUNT} certificates!"
	fi
	return 0
}

compute_certificate_san()
{
	################################################################################
	#
	# Compute all the values to be added to the certificate's SAN
	#
	################################################################################
	FQDN="$(hostname -f)"
	read POD SERVICE NAMESPACE SVC REST <<< "${FQDN//./ }"

	set_or_default SSL_EXTRA_SAN
	set_as_boolean SSL_EXTRA_SAN_STRICT
	set_or_default SSL_SERVICE_EXTRA_NAMES

	# Make sure the cluster domain is formatted correctly, removing any leading
	# or trailing spaces, and multiple consecutive spaces get collapsed into a
	# single dot, yielding a valid domain name
	CLUSTER_DOMAIN="$(echo -n "${REST}" | sed -e 's;^\s*;;g' -e 's;\s*$;;g' -e 's;\s\+;.;g')"

	VARIATIONS=( "${NAMESPACE}" "${SVC}" "${CLUSTER_DOMAIN}" )

	SAN=( ${FQDN} $(list_hostname_variations "${POD}" "${SERVICE}" "${VARIATIONS[@]}") )

	[ -n "${SERVICE}" ] && \
		SAN+=( $(list_hostname_variations "${SERVICE}" "${VARIATIONS[@]}") )

	# ACME_SERVICE_NAME is the "consumable" service, while
	# SERVICE is the (possibly headless) default service
	# associated to a pod. They *may* be the same but
	# aren't required to be. Thus, we check to see if they're
	# the same, to avoid adding duplicate values
	set_or_default ACME_SERVICE_NAME "${SERVICE}"
	[ "${ACME_SERVICE_NAME}" != "${SERVICE}" ] && \
		SAN+=( $(list_hostname_variations "${ACME_SERVICE_NAME}" "${VARIATIONS[@]}") )

	# These are extra service names through which this
	# same pod may be reached
	#
	# The string may have multiple basenames (no dots!),
	# and be separated by commas, spaces, or colons
	while read EXTRA_NAME ; do
		[[ "${EXTRA_NAME}" =~ [.] ]] && fail "Invalid value in SSL_SERVICE_EXTRA_NAMES: [${EXTRA_NAME}] - may not contain dots"
		is_valid_hostname_part "${EXTRA_NAME}" || fail "Invalid value in SSL_SERVICE_EXTRA_NAMES: [${EXTRA_NAME}] is not a valid RFC-1123 hostname part"
		SAN+=( $(list_hostname_variations "${EXTRA_NAME}" "${VARIATIONS[@]}") )
	done < <(split_hostnames "${SSL_SERVICE_EXTRA_NAMES}")

	[ -v POD_IP ] && \
		POD_IP="$(validate_ip "${POD_IP}")" && [ "${POD_IP}" != "127.0.0.1" ] && SAN+=( "${POD_IP}" )

	# The least specific values
	SAN+=(
		"${POD}"
		"localhost.localdomain"
		"localhost"
	)

	# These two are added to support developer machines, but they only get enabled
	# when using our developer-centric K8s deployment
	#
	set_or_default LOCAL_DEV_HOSTNAME "k8s.cluster.prv"
	if is_valid_hostname "${LOCAL_DEV_HOSTNAME}" ; then
		# This should be an instant resolve for our developer machines. A lookup
		# failure (i.e. a timeout) simply means we're not on one of them
		LOCAL_DEV_IPV4="$(dig +short +timeout=1 +retry=0 "${LOCAL_DEV_HOSTNAME}" 2>/dev/null)" || LOCAL_DEV_IPV4=""
		if is_valid_ipv4 "${LOCAL_DEV_IPV4}" ; then
			warn "Adding the local development SAN entries: ${LOCAL_DEV_HOSTNAME}/${LOCAL_DEV_IPV4}"
			SAN+=(
				"${LOCAL_DEV_IPV4}"
				"${LOCAL_DEV_HOSTNAME}"
			)
		fi
	fi

	# Add the extra SAN names, if provided. The list can be separated by spaces, commas, or colons
	while read S ; do
		if is_valid_ipv4 "${S}" || is_valid_hostname "${S}" ; then
			SAN+=( "${S}" )
		else
			# If we're strict, we explode ... we don't warn
			local CMD="fail"
			as_boolean "${SSL_EXTRA_SAN_STRICT}" || CMD="warn"
			"${CMD}" "The value [${S}] from SSL_EXTRA_SAN is neither a valid IP nor a valid hostname"
		fi
	done < <(split_hostnames "${SSL_EXTRA_SAN}")
	return 0
}

can_read_as_key_owner()
{
	local FILE="${1}"
	[ "${KEY_OWNER}" == "root" ] && return 0
	runuser -u "${KEY_OWNER}" -- test -r "${FILE}" &>/dev/null || return 1
	return 0
}

initialize_password()
{
	################################################################################
	#
	# Generate the key's password file
	#
	################################################################################
	SSL_PASSWORD_FILE_PROVIDED="false"
	if [ -v SSL_PASSWORD_FILE ] ; then
		[ -n "${SSL_PASSWORD_FILE}" ] || fail "The variable SSL_PASSWORD_FILE may not be empty"
		[ -s "${SSL_PASSWORD_FILE}" ] || fail "The password file [${SSL_PASSWORD_FILE}] may not be empty"

		# Its location is published for the key owner to use, so they must be able to read it
		can_read_as_key_owner "${SSL_PASSWORD_FILE}" || fail "The password file [${SSL_PASSWORD_FILE}] must be readable by ${KEY_OWNER}"
		SSL_PASSWORD_FILE_PROVIDED="true"
	else
		# We weren't given a password file to use, so use the default value
		export SSL_PASSWORD_FILE="${SSL_DIR}/.password"

		# Allow the use of SSL_PASSWORD to set the password. This isn't
		# particularly secure, but it may be required in some instances where the
		# pod needs to know the password beforehand (i.e. b/c Helm needs to know it)
		if [ -v SSL_PASSWORD ] ; then
			[ -n "${SSL_PASSWORD}" ] || fail "The variable SSL_PASSWORD may not be empty"
			echo -n "${SSL_PASSWORD}" > "${SSL_PASSWORD_FILE}" || fail "Failed to render the password file at [${SSL_PASSWORD_FILE}] with the password given in SSL_PASSWORD"
		else
			# We weren't given a password, so just render a random one
			render_password > "${SSL_PASSWORD_FILE}" || fail "Failed to render a new password into [${SSL_PASSWORD_FILE}]"
		fi
	fi

	export SSL_PASSWORD="$(<"${SSL_PASSWORD_FILE}")"
	return 0
}

initialize()
{
	ensure_dir "${SSL_DIR}"

	set_or_default SSL_CERTIFICATE "${SSL_DIR}/cert.pem"
	set_or_default SSL_PRIVATE_KEY "${SSL_DIR}/key.pem"
	set_or_default SSL_PRIVATE_KEY_ENCRYPTED "${SSL_DIR}/key.aes.pem"
	set_or_default SSL_CA_ROOT "${SSL_DIR}/ca-root.pem"
	set_or_default SSL_CA_INT "${SSL_DIR}/ca-int.pem"
	set_or_default SSL_CA_CHAIN "${SSL_DIR}/ca-chain.pem"

	# Export, just in case ...
	export SSL_PASSWORD_FILE SSL_CERTIFICATE SSL_PRIVATE_KEY SSL_PRIVATE_KEY_ENCRYPTED SSL_CA_ROOT SSL_CA_INT SSL_CA_CHAIN

	export SSL_CERTIFICATE_HAPROXY="${SSL_DIR}/haproxy-cert.pem"
	export SSL_CA_TRUSTS="${OS_SSL_CA_TRUSTS}"

	initialize_password

	SSL_ENV_FILE_VARS+=(
		SSL_PASSWORD
		SSL_PASSWORD_FILE

		SSL_CA_ROOT
		SSL_CA_TRUSTS
	)

	# These are only published if a certificate is actually generated, since
	# some containers only need the trusts. The Java options are only added
	# to JAVAX_NET_SSL_OPTS in that case, too
	CERT_ENV_FILE_VARS=(
		SSL_PRIVATE_KEY
		SSL_PRIVATE_KEY_ENCRYPTED
		SSL_CERTIFICATE
		SSL_CERTIFICATE_HAPROXY

		SSL_CA_INT
		SSL_CA_CHAIN
	)
	JAVAX_NET_SSL_KEY_OPTS=()

	################################################################################
	#
	# These are deprecated. Remove when it's safe to do so
	#
	# UPDATE: 20260927 - should be safe to remove these already for the currently
	#		 built containers. Leave it for next weekend's build.
	# export SSL_ROOT="${SSL_CA_ROOT}"
	# export SSL_INT="${SSL_CA_INT}"
	# export SSL_CHAIN="${SSL_CA_CHAIN}"
	# export SSL_PRIVATE_KEY_AES="${SSL_PRIVATE_KEY_ENCRYPTED}"
	#
	# SSL_ENV_FILE_VARS+=(
	#	SSL_ROOT
	#	SSL_INT
	#	SSL_CHAIN
	#	SSL_PRIVATE_KEY_AES
	# )
	#
	################################################################################

	################################################################################
	#
	# If we're doing the Java thing, then set up all the Java stuff
	#
	################################################################################
	as_boolean "${KEYTOOL}" || return 0

	set_or_default JAVA_SSL_KEYSTORE_TYPE
	set_or_default JAVA_SSL_KEYSTORE_PROVIDER
	set_or_default JAVA_SSL_KEYSTORE_PROVIDER_CLASS
	set_or_default JAVA_SSL_KEYSTORE_PROVIDER_PATH
	set_or_default JAVA_SSL_KEYSTORE_PROVIDER_ARGS

	#
	# Allow using dashes to "blank out" parameters
	#
	[ "${JAVA_SSL_KEYSTORE_PROVIDER}" == "-" ] && JAVA_SSL_KEYSTORE_PROVIDER=""
	[ "${JAVA_SSL_KEYSTORE_PROVIDER_CLASS}" == "-" ] && JAVA_SSL_KEYSTORE_PROVIDER_CLASS=""
	[ "${JAVA_SSL_KEYSTORE_PROVIDER_PATH}" == "-" ] && JAVA_SSL_KEYSTORE_PROVIDER_PATH=""
	[ "${JAVA_SSL_KEYSTORE_PROVIDER_ARGS}" == "-" ] && JAVA_SSL_KEYSTORE_PROVIDER_ARGS=""

	# The path must be a directory, not a file
	if is_dir_readable "${JAVA_SSL_KEYSTORE_PROVIDER_PATH}" ; then
		JARS=""
		while read JAR ; do
			is_file_readable "${JAR}" && JARS+="${JARS:+:}${JAR}" && continue
			warn "The Keystore provider file [${JAR}] is not readable!"
		done < <(find "${JAVA_SSL_KEYSTORE_PROVIDER_PATH}" -mindepth 1 -maxdepth 1 -type f \( -iname '*.jar' -or -iname '*.zip' \) | sort -u)
		[ -n "${JARS}" ] && JAVA_SSL_KEYSTORE_PROVIDER_PATH="${JARS}" || warn "No SSL providers found at ${JAVA_SSL_KEYSTORE_PROVIDER_PATH@Q}"
	elif [ -n "${JAVA_SSL_KEYSTORE_PROVIDER_PATH}" ] ; then
		fail "The value for JAVA_SSL_KEYSTORE_PROVIDER_PATH must be a directory, which ${JAVA_SSL_KEYSTORE_PROVIDER_PATH@Q} is not!"
	fi

	#
	# Define all the Java-related variables
	#
	export JAVA_KEYSTORE_TYPE="${JAVA_SSL_KEYSTORE_TYPE}"
	export JAVA_KEYSTORE="${SSL_DIR}/keystore.${JAVA_KEYSTORE_TYPE,,}"
	export JAVA_KEYSTORE_PASSWORD="${SSL_PASSWORD}"
	export JAVA_KEYSTORE_PASSWORD_FILE="${SSL_PASSWORD_FILE}"
	export JAVA_KEYSTORE_PROVIDER="${JAVA_SSL_KEYSTORE_PROVIDER}"
	export JAVA_KEYSTORE_PROVIDER_CLASS="${JAVA_SSL_KEYSTORE_PROVIDER_CLASS}"
	export JAVA_KEYSTORE_PROVIDER_PATH="${JAVA_SSL_KEYSTORE_PROVIDER_PATH}"
	export JAVA_KEYSTORE_PROVIDER_ARGS="${JAVA_SSL_KEYSTORE_PROVIDER_ARGS}"

	export JAVA_TRUSTSTORE_TYPE="${JAVA_KEYSTORE_TYPE}"
	export JAVA_TRUSTSTORE="${JAVA_KEYSTORE}"
	export JAVA_TRUSTSTORE_PASSWORD="${JAVA_KEYSTORE_PASSWORD}"
	export JAVA_TRUSTSTORE_PASSWORD_FILE="${JAVA_KEYSTORE_PASSWORD_FILE}"
	export JAVA_TRUSTSTORE_PROVIDER="${JAVA_KEYSTORE_PROVIDER}"
	export JAVA_TRUSTSTORE_PROVIDER_CLASS="${JAVA_KEYSTORE_PROVIDER_CLASS}"
	export JAVA_TRUSTSTORE_PROVIDER_PATH="${JAVA_KEYSTORE_PROVIDER_PATH}"
	export JAVA_TRUSTSTORE_PROVIDER_ARGS="${JAVA_KEYSTORE_PROVIDER_ARGS}"

	# These will either already be set in the environment, or
	# will be populated by their matching DEFAULT_* values
	# defined at the top of this file
	set_or_default JAVA_GLOBAL_TRUSTSTORE_TYPE
	set_or_default JAVA_GLOBAL_TRUSTSTORE
	set_or_default JAVA_GLOBAL_TRUSTSTORE_PASSWORD
	# This one is read by keytool from the environment
	export JAVA_GLOBAL_TRUSTSTORE_PASSWORD
	set_or_default JAVA_GLOBAL_TRUSTSTORE_PROVIDER
	set_or_default JAVA_GLOBAL_TRUSTSTORE_PROVIDER_CLASS

	#
	# Add the Java variables to the environment file
	# in preparation for the final output
	#
	CERT_ENV_FILE_VARS+=(
		JAVA_KEYSTORE
		JAVA_KEYSTORE_PASSWORD_FILE
		JAVA_KEYSTORE_PASSWORD
		JAVA_KEYSTORE_TYPE
		JAVA_KEYSTORE_PROVIDER_CLASS
		JAVA_KEYSTORE_PROVIDER
		JAVA_KEYSTORE_PROVIDER_PATH
		JAVA_KEYSTORE_PROVIDER_ARGS
	)

	SSL_ENV_FILE_VARS+=(
		JAVA_TRUSTSTORE
		JAVA_TRUSTSTORE_PASSWORD_FILE
		JAVA_TRUSTSTORE_PASSWORD
		JAVA_TRUSTSTORE_TYPE
		JAVA_TRUSTSTORE_PROVIDER_CLASS
		JAVA_TRUSTSTORE_PROVIDER
		JAVA_TRUSTSTORE_PROVIDER_PATH
		JAVA_TRUSTSTORE_PROVIDER_ARGS

		JAVA_GLOBAL_TRUSTSTORE_TYPE
		JAVA_GLOBAL_TRUSTSTORE
		JAVA_GLOBAL_TRUSTSTORE_PASSWORD
		JAVA_GLOBAL_TRUSTSTORE_PROVIDER
		JAVA_GLOBAL_TRUSTSTORE_PROVIDER_CLASS
	)

	JAVAX_NET_SSL_KEY_OPTS=(
		-Djavax.net.ssl.keyStore='${JAVA_KEYSTORE}'
		-Djavax.net.ssl.keyStorePasswordFile='${JAVA_KEYSTORE_PASSWORD_FILE}'
		-Djavax.net.ssl.keyStorePassword='${JAVA_KEYSTORE_PASSWORD}'
		-Djavax.net.ssl.keyStoreType='${JAVA_KEYSTORE_TYPE}'
	)
	[ -n "${JAVA_KEYSTORE_PROVIDER}" ] && JAVAX_NET_SSL_KEY_OPTS+=( -Djavax.net.ssl.keyStoreProvider='${JAVA_KEYSTORE_PROVIDER}' )
	[ -n "${JAVA_KEYSTORE_PROVIDER_CLASS}" ] && JAVAX_NET_SSL_KEY_OPTS+=( -Djavax.net.ssl.keyStoreProviderClass='${JAVA_KEYSTORE_PROVIDER_CLASS}' )

	JAVAX_NET_SSL_OPTS=(
		-Djavax.net.ssl.trustStore='${JAVA_TRUSTSTORE}'
		-Djavax.net.ssl.trustStorePasswordFile='${JAVA_TRUSTSTORE_PASSWORD_FILE}'
		-Djavax.net.ssl.trustStorePassword='${JAVA_TRUSTSTORE_PASSWORD}'
		-Djavax.net.ssl.trustStoreType='${JAVA_TRUSTSTORE_TYPE}'
	)

	KEYTOOL_PROVIDER_FLAGS=()
	if [ -n "${JAVA_KEYSTORE_PROVIDER}" ] || [ -n "${JAVA_KEYSTORE_PROVIDER_CLASS}" ] ; then
		PARAM=""
		# Important: for Keytool, prefer the provider class vs. the symbolic name
		if [ -n "${JAVA_KEYSTORE_PROVIDER_CLASS}" ] ; then
			PARAM="-providerclass"
			VALUE="${JAVA_KEYSTORE_PROVIDER_CLASS}"
		elif [ -n "${JAVA_KEYSTORE_PROVIDER}" ] ; then
			PARAM="-addprovider"
			VALUE="${JAVA_KEYSTORE_PROVIDER}"
		fi
		if [ -n "${PARAM}" ] ; then
			KEYTOOL_PROVIDER_FLAGS+=( "${PARAM}" "${VALUE}" )
			[ -n "${JAVA_KEYSTORE_PROVIDER_ARGS}" ] && KEYTOOL_PROVIDER_FLAGS+=( -providerarg "${JAVA_KEYSTORE_PROVIDER_ARGS}" )
		fi
	fi
	[ -n "${JAVA_KEYSTORE_PROVIDER_PATH}" ] && KEYTOOL_PROVIDER_FLAGS+=( -providerpath "${JAVA_KEYSTORE_PROVIDER_PATH}" )
	return 0
}

install_intermediates()
{
	# Extract the certificate and any intermediates chain (don't import, will happen automatically later)
	local SRC="${1}"
	if [ $(grep -c -- "-----END CERTIFICATE-----" "${SRC}") -gt 1 ] ; then
		say "📂 Extracting the intermediate certificates from the signed bundle..."
		sed -e '0,/-----END CERTIFICATE-----/d' < "${SRC}" > "${SSL_CA_INT}" || fail "Failed to extract the intermediate CAs from the signed bundle (rc=${?})"
		PUBLIC_FILES+=( "${SSL_CA_INT}" )
		ok "Intermediates ready!"
		install_chain "${OS_SSL_ANCHORS}/ca-int" "${OS_SSL_SUFFIX}" < "${SSL_CA_INT}" || fail "Failed to install the certificate chain from [${SSL_CA_INT}]"
	fi
	return 0
}

render_encrypted_key()
{
	#
	# The OpenSSL version in Ubuntu 24.04 FIPS has a hardcoded salt size of 8 bytes
	# for PKCS#8 encryption. For FIPS we need 16, so pkcs8-encrypt is used instead.
	# The password is read from the environment, so it's never on any command line.
	#
	say "🔒 Creating a PKCS#8 encrypted version of the key (PBES2 with AES-256-CBC)..."

	local ARGS=( SSL_PASSWORD )
	set_or_default SSL_PBKDF2_ITERATIONS
	[ -n "${SSL_PBKDF2_ITERATIONS}" ] && ARGS+=( "${SSL_PBKDF2_ITERATIONS}" )

	local OUT=""
	OUT="$( { openssl pkcs8 -topk8 -nocrypt -outform DER -in "${SSL_PRIVATE_KEY}" | pkcs8-encrypt "${ARGS[@]}" > "${SSL_PRIVATE_KEY_ENCRYPTED}" ; } 2>&1 )" || fail "Failed to render the encrypted key at [${SSL_PRIVATE_KEY_ENCRYPTED}] (rc=${?}): ${OUT}"
	PUBLIC_FILES+=( "${SSL_PRIVATE_KEY_ENCRYPTED}" )
	ok "PKCS#8 encrypted key ready!"
	return 0
}

generate_certificate()
{

	#
	# If we weren't given a certificate, then we must create our own
	#
	set_or_default ACME_PASSWORD_FILE "/.acme.password"
	if ! is_file_readable "${ACME_PASSWORD_FILE}" ; then
		warn "Couldn't find the provisioner password file at [${ACME_PASSWORD_FILE}], so only the trusts will be deployed"
		return 0
	fi

	# Always do these things for new certifiates!
	compute_certificate_san

	# Don't call these in an || or && list, since that would disable set -e within them
	local CMD="generate_java"
	as_boolean "${KEYTOOL}" || CMD="generate_pem"
	"${CMD}"

	install_intermediates "${SSL_CERTIFICATE}"

	render_encrypted_key

	local OUT=""

	say "📜 Rendering the certificate files for HAProxy..."
	OUT="$( (cat "${SSL_CERTIFICATE}" "${SSL_CA_ROOT}" "${SSL_PRIVATE_KEY}" > "${SSL_CERTIFICATE_HAPROXY}") 2>&1)" \
		&& ok "HAProxy certificate ready!" \
		|| fail "Failed to generate the HAProxy certificate"

	local LIST=()
	for C in "${SSL_CA_INT}" "${SSL_CA_ROOT}" ; do
		is_file_readable "${C}" && LIST+=( "${C}" )
	done

	if [ ${#LIST[@]} -gt 0 ] ; then
		say "📜 Rendering the CA chain certifiate..."
		OUT="$( (cat "${LIST[@]}" > "${SSL_CA_CHAIN}") 2>&1)" \
			&& PUBLIC_FILES+=( "${SSL_CA_CHAIN}" ) \
			&& ok "CA chain generated!" \
			|| fail "Failed to generate the CA chain (rc=${?}): ${OUT}"
	fi

	# The certificate is ready, so its variables may now be published
	SSL_ENV_FILE_VARS+=( "${CERT_ENV_FILE_VARS[@]}" )
	JAVAX_NET_SSL_OPTS+=( "${JAVAX_NET_SSL_KEY_OPTS[@]}" )

	ok "Certificate generation complete!"
	return 0
}

generate_java()
{
	as_boolean "${KEYTOOL}" || return 0
	say "🔐 Rendering a ${JAVA_KEYSTORE_TYPE} Keystore with the new certificate & key..."

	# By now we have a private key in plaintext, and a certificate. At this point
	# we can turn those two into a keystore that includes the private key and
	# the certificate, and import it into our keystore.

	export JAVA_KEY_ALIAS="acme"
	export JAVA_KEY_PASSWORD="${JAVA_KEYSTORE_PASSWORD}"
	export JAVA_KEY_PASSWORD_FILE="${JAVA_KEYSTORE_PASSWORD_FILE}"
	export SSL_CERTIFICATE_TOMCAT="${SSL_DIR}/tomcat-${SSL_CERTIFICATE##*/}"

	SSL_ENV_FILE_VARS+=(
		SSL_CERTIFICATE_TOMCAT
		JAVA_KEY_ALIAS
		JAVA_KEY_PASSWORD_FILE
		JAVA_KEY_PASSWORD
	)

	JAVAX_NET_SSL_OPTS+=(
		-Djavax.net.ssl.keyAlias='${JAVA_KEY_ALIAS}'
		-Djavax.net.ssl.keyPasswordFile='${JAVA_KEY_PASSWORD_FILE}'
		-Djavax.net.ssl.keyPassword='${JAVA_KEY_PASSWORD}'
	)

	KT_SAN=""
	[ "${#SAN[@]}" -gt 0 ] && say "📝 Rendering certificate for the following SANs:"
	while read S ; do
		say "\t${S}"
		is_valid_ipv4 "${S}" && TYPE="ip" || TYPE="dns"
		[ -n "${KT_SAN}" ] && KT_SAN+=","
		KT_SAN+="${TYPE}:${S}"
	done < <(echo "${SAN[@]}" | tr '[:space:]' '\n' | sed -e '/^\s*$/d' | sort -u)
	[ -n "${KT_SAN}" ] && KT_SAN=(-ext "san=${KT_SAN}") || KT_SAN=()

	# First, generate the certificate key
	say "🔑 Generating the certificate key..."
	local CMD=()
	CMD=(
		keytool -genkey
			-alias "${JAVA_KEY_ALIAS}"
			-dname "CN=${FQDN}"
			-keyalg RSA
			-keypass:file "${JAVA_KEY_PASSWORD_FILE}"
			-keysize 2048
			-keystore "${JAVA_KEYSTORE}"
			-storetype "${JAVA_KEYSTORE_TYPE}"
			-storepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			-startdate "-90m"
			-validity 548
			"${KT_SAN[@]}"
			"${KEYTOOL_PROVIDER_FLAGS[@]}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to generate the ${JAVA_KEYSTORE_TYPE} keystore (rc=${?}): ${OUT}"
	ok "The key is ready!"

	# Generate the CSR
	say "✍ Generating the certificate signing request..."
	CSR="$(mktemp --tmpdir="${SSL_DIR}" .csr.XXXXXXXX)" || fail "Failed to create a temporary CSR file"
	GARBAGE+=( "${CSR}" )
	CMD=(
		keytool -certreq
			-alias "${JAVA_KEY_ALIAS}"
			-file "${CSR}"
			-keystore "${JAVA_KEYSTORE}"
			-keypass:file "${JAVA_KEY_PASSWORD_FILE}"
			-storetype "${JAVA_KEYSTORE_TYPE}"
			-storepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			"${KT_SAN[@]}"
			"${KEYTOOL_PROVIDER_FLAGS[@]}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to generate the CSR (rc=${?}): ${OUT}"
	ok "The request is ready!"

	# Get the CSR signed
	say "🔎︎ Submitting the certificate signing request..."
	CMD=(
		step ca sign "${CSR}" "${SSL_CERTIFICATE}"
		--force
		--not-before="-1h30m"
		--provisioner-password-file "${ACME_PASSWORD_FILE}"
		--password-file="${SSL_PASSWORD_FILE}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to get the certificate signature (rc=${?}): ${OUT}"
	PUBLIC_FILES+=( "${SSL_CERTIFICATE}" )

	say "🔓 Creating the simplified Tomcat Certificate..."
	CMD=(cp "${SSL_CERTIFICATE}" "${SSL_CERTIFICATE_TOMCAT}")
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to create a copy of the SSL Certificate for Tomcat use (rc=${?}): ${OUT}"
	PUBLIC_FILES+=( "${SSL_CERTIFICATE_TOMCAT}" )

	say "\t...sanitize the Tomcat Certificate"
	CMD=(
		sed -n -i
			-e '/-----BEGIN CERTIFICATE-----/,$p' -e '/^-\+END CERTIFICATE-\+$/q'
			"${SSL_CERTIFICATE_TOMCAT}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to sanitize the SSL Certificate for Tomcat use (rc=${?}): ${OUT}"
	ok "Tomcat Certificate ready!"

	set_as_boolean SSL_DH_APPEND "false"
	if as_boolean "${SSL_DH_APPEND}" ; then
		say "🛡️ Rendering the Diffie-Hellman parameters..."
		OUT="$(openssl dhparam -outform pem -out "${SSL_DIR}/dh.pem" 2048 2>&1)"  || fail "Failed to generate the DH parameters (rc=${?}): ${OUT}"
		PUBLIC_FILES+=( "${SSL_DIR}/dh.pem" )
		say "💾 Appending Diffie-Hellman parameters to the SSL Certificate for Tomcat use"
		( echo "" ; cat "${SSL_DIR}/dh.pem" ) >> "${SSL_CERTIFICATE_TOMCAT}" || fail "Failed to append the DH parameters to the certifiate"
		ok "DH parameters appended!"
	fi
	ok "The certificate was signed!"

	# We import the signers as well
	say "🔓 Importing the signed certificate into the keystore..."
	CMD=(
		keytool -import
			-alias "${JAVA_KEY_ALIAS}"
			-file "${SSL_CERTIFICATE}"
			-keystore "${JAVA_KEYSTORE}"
			-noprompt
			-storetype "${JAVA_KEYSTORE_TYPE}"
			-storepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			"${KEYTOOL_PROVIDER_FLAGS[@]}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to import the signed certificate into the keystore (rc=${?}): ${OUT}"
	ok "The keystore is ready!"

	# Export the private key as PKCS#12 so it can be dumped
	# to PEM format using OpenSSL commands, which in turn
	# makes it readable by processes using OpenSSL
	say "🔑 Extracting the private key into a PEM-encoded file"
	TEMP_KEYSTORE="$(mktemp --tmpdir="${SSL_DIR}" ".temp-keystore-XXXXXXXX.pkcs12")"
	say "\t...create a temporary keystore"
	# We need to nuke it, otherwise keytool will complain
	rm -f "${TEMP_KEYSTORE}" &>/dev/null || true
	GARBAGE+=( "${TEMP_KEYSTORE}" )
	# Providers may be blanked out, in which case keytool must choose them
	local PROVIDER_FLAGS=()
	[ -n "${JAVA_KEYSTORE_PROVIDER}" ] && PROVIDER_FLAGS+=( -srcprovidername "${JAVA_KEYSTORE_PROVIDER}" )
	CMD=(
		keytool -importkeystore
			-destalias "${JAVA_KEY_ALIAS}"
			-destkeypass:file "${JAVA_KEY_PASSWORD_FILE}"
			-destkeystore "${TEMP_KEYSTORE}"
			-deststorepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			-deststoretype "PKCS12"
			-destprovidername "SUN"
			-noprompt
			-srcalias "${JAVA_KEY_ALIAS}"
			-srckeypass:file "${JAVA_KEY_PASSWORD_FILE}"
			-srckeystore "${JAVA_KEYSTORE}"
			-srcstorepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			-srcstoretype "${JAVA_KEYSTORE_TYPE}"
			"${PROVIDER_FLAGS[@]}"
			"${KEYTOOL_PROVIDER_FLAGS[@]}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to export the private key to the temporary keystore (rc=${?}): ${OUT}"

	# Spit out the plaintext private key
	say "\t...extract the plaintext key"
	CMD=(
		openssl pkcs12
			-in "${TEMP_KEYSTORE}"
			-noenc
			-nocerts
			-nomacver
			-passin "file:${JAVA_KEYSTORE_PASSWORD_FILE}"
			-out "${SSL_PRIVATE_KEY}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to extract the private key from the temporary keystore (rc=${?}): ${OUT}"

	# Sanitize the private key to remove any extraneous text
	say "\t...sanitize the temporary file"
	CMD=(
		sed -n -i
			-e '/-----BEGIN PRIVATE KEY-----/,$p' -e '/^-\+END PRIVATE KEY-\+$/q'
			"${SSL_PRIVATE_KEY}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to sanitize the private key (rc=${?}): ${OUT}"

	# Convert the key to PKCS#1 for consistency with the keys generated by step-ca, since
	# some programs (i.e. RustFS) only accept that format. This only re-encodes the key's
	# ASN.1 structure, so no cryptographic operations are involved
	say "\t...convert to PKCS#1"
	local PKCS1_KEY=""
	PKCS1_KEY="$(mktemp --tmpdir="${SSL_DIR}" ".pkcs1-key-XXXXXXXX.pem")" || fail "Failed to create a temporary file for the PKCS#1 key"
	GARBAGE+=( "${PKCS1_KEY}" )
	CMD=(
		openssl pkey
			-in "${SSL_PRIVATE_KEY}"
			-traditional
			-out "${PKCS1_KEY}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to convert the private key to PKCS#1 (rc=${?}): ${OUT}"
	OUT="$(mv -f "${PKCS1_KEY}" "${SSL_PRIVATE_KEY}" 2>&1)" || fail "Failed to replace the private key with its PKCS#1 version (rc=${?}): ${OUT}"
	ok "Private key extracted!"

	ok "Java Keystore Ready!"
	return 0
}

generate_pem()
{
	########################################
	# No Java, use OpenSSL only
	########################################
	# Make sure our SAN list is unique, and
	# sorted, and pre-pend the --san argument
	SAN_ARG=()
	[ "${#SAN[@]}" -gt 0 ] && say "📝 Rendering certificate for the following SANs:"
	while read S ; do
		say "\t${S}"
		SAN_ARG+=( --san "${S}" )
	done < <(echo "${SAN[@]}" | tr '[:space:]' '\n' | sed -e '/^\s*$/d' | sort -u)

	# Note: the not-before is "back in time" to accommodate for clock skew. We've
	# observed that when there's a bit of clock skew, certificate issuance goes
	# kind of wonky b/c the cert will be OK, but it will not be accepted by the
	# consuming processes until the not-before time has past. By using a back-in-time
	# approach we ensure that the certificate will always be "born ready"
	say "🔐 Rendering a new certificate for this pod's use"
	local CMD=(
		step ca certificate
			"${FQDN}" "${SSL_CERTIFICATE}" "${SSL_PRIVATE_KEY}"
			"${SAN_ARG[@]}"
			--force
			--not-before="-1h30m"
			--size 2048
			--kty RSA
			--provisioner-password-file "${ACME_PASSWORD_FILE}"
			--password-file="${SSL_PASSWORD_FILE}"
	)
	local OUT=""
	OUT="$("${CMD[@]}" 2>&1)" || fail "Failed to generate the certificate (rc=${?}): ${OUT}"
	PUBLIC_FILES+=( "${SSL_CERTIFICATE}" )
	ok "SSL Certificate Ready!"
	return 0
}

update_trusts()
{
	say "🛠️ Updating the trusted certificates..."
	chown -R root:root "${OS_SSL_ANCHORS}"
	chmod -R u=rwX,go=rX "${OS_SSL_ANCHORS}"
	# The system trusts must remain readable by everyone. The command substitution runs
	# in a subshell, so the relaxed umask only applies to the update command
	OUT="$(umask 0022 && execute "${OS_SSL_UPDATE_CMD[@]}" 2>&1)" || fail "Failed to update the CA trusts (rc=${?}): ${OUT}"
	ok "CA trusts updated system-wide!"

	import_java_trusts
	return 0
}

import_java_trusts()
{
	as_boolean "${KEYTOOL}" || return 0
	say "🔓 Adding the global trusts to the ${JAVA_KEYSTORE_TYPE} keystore!"
	# Providers may be blanked out, in which case keytool must choose them
	local PROVIDER_FLAGS=()
	[ -n "${JAVA_KEYSTORE_PROVIDER}" ] && PROVIDER_FLAGS+=( -destprovidername "${JAVA_KEYSTORE_PROVIDER}" )
	[ -n "${JAVA_GLOBAL_TRUSTSTORE_PROVIDER}" ] && PROVIDER_FLAGS+=( -srcprovidername "${JAVA_GLOBAL_TRUSTSTORE_PROVIDER}" )
	local CMD=(
		keytool -importkeystore
			-destkeystore "${JAVA_KEYSTORE}"
			-deststorepass:file "${JAVA_KEYSTORE_PASSWORD_FILE}"
			-deststoretype "${JAVA_KEYSTORE_TYPE}"
			-noprompt
			-srckeystore "${JAVA_GLOBAL_TRUSTSTORE}"
			-srcstorepass:env JAVA_GLOBAL_TRUSTSTORE_PASSWORD
			-srcstoretype "${JAVA_GLOBAL_TRUSTSTORE_TYPE}"
			"${PROVIDER_FLAGS[@]}"
			"${KEYTOOL_PROVIDER_FLAGS[@]}"
	)
	OUT="$("${CMD[@]}" 2>&1)" || fail "Could not append the global trusts from [${JAVA_GLOBAL_TRUSTSTORE}] (rc=${?}): ${OUT}"
	PUBLIC_FILES+=( "${JAVA_KEYSTORE}" )
	ok "Global trusts added!"
	return 0
}

finalize_java_variables()
{
	as_boolean "${KEYTOOL}" || return 0

	# These two go last b/c they'll be the biggest and baddest, so the file is easier to read
	SSL_ENV_FILE_VARS+=( JAVAX_NET_SSL_OPTIONS )
	SSL_ENV_FILE_VARS+=( JAVA_KEYTOOL_PROVIDER_FLAGS )

	# Add these two last, in case there's no reason to add them
	[ -n "${JAVA_TRUSTSTORE_PROVIDER}" ] && JAVAX_NET_SSL_OPTS+=( -Djavax.net.ssl.trustStoreProvider='${JAVA_TRUSTSTORE_PROVIDER}' )
	[ -n "${JAVA_TRUSTSTORE_PROVIDER_CLASS}" ] && JAVAX_NET_SSL_OPTS+=( -Djavax.net.ssl.trustStoreProviderClass='${JAVA_TRUSTSTORE_PROVIDER_CLASS}' )

	export JAVA_KEYTOOL_PROVIDER_FLAGS="${KEYTOOL_PROVIDER_FLAGS[*]}"

	#
	# Render the final JVM options consuming all the above variables
	#
	export JAVAX_NET_SSL_OPTIONS="$(echo -n "${JAVAX_NET_SSL_OPTS[@]}" | envsubst)"
	return 0
}

is_read_only_mount()
{
	local FILE="${1}"
	local OPTIONS=""
	OPTIONS="$(findmnt -n -o OPTIONS --target "$(readlink -f "${FILE}")")" || return 1
	[[ ",${OPTIONS}," == *,ro,* ]] || return 1
	return 0
}

secure_provided_password_file()
{
	# A password file we were given is only ours to modify if it's on a writable
	# filesystem (i.e. not a mounted Kubernetes secret), and already belongs to
	# the key owner. Otherwise, we could be handing someone else's file over
	local FILE="$(readlink -f "${SSL_PASSWORD_FILE}")"
	if is_read_only_mount "${FILE}" ; then
		say "The password file [${SSL_PASSWORD_FILE}] is on a read-only filesystem, its permissions will be left as-is"
	elif [ "$(stat -c '%u' "${FILE}")" != "$(id -u "${KEY_OWNER}")" ] ; then
		say "The password file [${SSL_PASSWORD_FILE}] isn't owned by ${KEY_OWNER}, its permissions will be left as-is"
	else
		chmod u=rX,go= "${FILE}" || warn "Failed to restrict the permissions for the password file [${SSL_PASSWORD_FILE}]"
	fi
	return 0
}

relax_permissions()
{
	# A password file we were given is never subject to the blanket treatment
	local SKIP=()
	as_boolean "${SSL_PASSWORD_FILE_PROVIDED}" && SKIP=( ! -samefile "$(readlink -f "${SSL_PASSWORD_FILE}")" )

	# Thanks to the umask, everything we've created is only accessible by root. By
	# default, the files are handed over to the user who will be consuming them, and
	# made read-only for that user alone (0400, or 0500 if executable) since many
	# programs reject private keys that are readable by anyone else. The directories
	# remain owned by root, and read-only for everyone (0555)
	say "🛡️ Securing the SSL files in [${SSL_DIR}]..."
	find "${SSL_DIR}" "${SKIP[@]}" -exec chown "${KEY_OWNER}:${ACM_GROUP}" {} +
	find "${SSL_DIR}" "${SKIP[@]}" -type f -exec chmod u=rX,go= {} +
	find "${SSL_DIR}" -type d -exec chown "root:${ACM_GROUP}" {} + -exec chmod a=rX {} +

	if as_boolean "${SSL_PASSWORD_FILE_PROVIDED}" ; then
		secure_provided_password_file
	fi

	# The files that are public, or are encrypted one way or another, are
	# read-only for everyone (0444, or 0555 if executable)
	if [ ${#PUBLIC_FILES[@]} -gt 0 ] ; then
		say "📖 Relaxing the permissions for the public SSL files: [ ${PUBLIC_FILES[@]@Q} ]"
		chown "root:${ACM_GROUP}" "${PUBLIC_FILES[@]}"
		chmod a=rX "${PUBLIC_FILES[@]}"
	fi
	return 0
}

finalize()
{
	local RC=${?}
	# Some of the garbage may already be gone, which mustn't stop us
	[ -v GARBAGE ] && { shred -u "${GARBAGE[@]}" &>/dev/null || true ; }

	# Shortcut - die early!
	as_boolean "${RESULT_OK}" || return ${RC}

	# Output the environment file
	local DIR="$(dirname "${SSL_ENV_FILE}")"
	mkdir -p "${DIR}" &>/dev/null

	# Output the variable values into a temporary file which is then moved into
	# place, since anyone waiting for it does so without holding the lock
	local UNDEF=()
	local ENV_FILE=""
	ENV_FILE="$(mktemp "${SSL_ENV_FILE}.XXXXXXXX")" || fail "Failed to create the temporary environment file"
	{
		echo "#!/bin/bash"
		echo ""
		echo "#"
		echo "# Source this file to define all SSL-related environment variables"
		echo "#"
		echo ""
		for VAR in "${SSL_ENV_FILE_VARS[@]}" ; do
			if [ -v "${VAR}" ] ; then
				echo "export ${VAR}=${!VAR@Q}"
			else
				UNDEF+=( "${VAR}" )
				echo "# ${VAR} was undefined"
			fi
		done
		echo ""
		echo "#"
		echo "# End of the SSL environment variable definitions"
		echo "#"
	} > "${ENV_FILE}"

	[ ${#UNDEF[@]} -gt 0 ] && \
		warn "The following variables were undefined [ ${UNDEF[@]} ]"

	# The file contains passwords, so only the consumer may read it
	chown "${KEY_OWNER}:${ACM_GROUP}" "${ENV_FILE}"
	chmod u=r,go= "${ENV_FILE}"
	mv -f "${ENV_FILE}" "${SSL_ENV_FILE}"
	return ${RC}
}


set_or_default SSL_DIR "/.ssl"
set_or_default SSL_ENV_FILE "${SSL_DIR}/.env"
set_or_default SSL_TRUSTS_DIR "/.trusts"

#
# This runs in a subshell so its EXIT trap (i.e. finalize) runs while the lock
# is still held. Otherwise, the lock would be released before the environment
# file was written, and a concurrent invocation could start all over again.
#
# IMPORTANT: this must not be invoked in an || or && list, or set -e would be
# disabled within it
#
(
	flock -x 999 || fail "Failed to acquire the execution lock for SSL initialization"

	mkdir -p "${SSL_DIR}" &>/dev/null

	################################################################################
	#
	# If we've already computed all our stuff, and saved it to the SSL_ENV_FILE,
	# we need not compute it again because it can be re-used from there
	#
	################################################################################
	is_file_readable "${SSL_ENV_FILE}" && quit "SSL is already initialized, you can load the settings from [${SSL_ENV_FILE}]"

	#
	# Make sure the environment file is created every time if we exit cleanly
	#
	export RESULT_OK="false"
	trap finalize EXIT

	#
	# Oh? Work to be done? Let's do some initial validations first ...
	#
	set_or_default ACM_GROUP
	[ -n "${ACM_GROUP}" ] || fail "The ACM_GROUP environment variable is REQUIRED"
	getent group "${ACM_GROUP}" &>/dev/null || fail "The group [${ACM_GROUP}] does not exist"

	# The private files will be handed over to whoever invoked us
	[ -v SUDO_USER ] && KEY_OWNER="${SUDO_USER}" || KEY_OWNER="root"

	#
	# Find the Java keytool, if it's installed
	#
	type -P keytool &>/dev/null && KEYTOOL="true" || KEYTOOL="false"

	################################################################################
	#
	# Define the FIPS flag for convenience
	#
	################################################################################
	is_fips && FIPS="true" || FIPS="false"
	export FIPS

	#
	# Configure any GoLang stuff
	#
	set_godebug_fips140

	#
	# These are the values we have to output into the environment
	# file at the end of processing
	#
	SSL_ENV_FILE_VARS=(
		SSL_DIR
		SSL_TRUSTS_DIR
		SSL_ENV_FILE

		FIPS
		GODEBUG
	)

	################################################################################
	#
	# Ok ... start doing the work!
	#
	################################################################################
	await_if_necessary

	# This array will contain the list of (absolute) paths for all
	# files whose permissions will be relaxed so they may be read
	# by everyone. All other files will only be readable by their
	# owner
	PUBLIC_FILES=()

	# This helps us do cleanup on exit
	GARBAGE=()

	initialize
	download_trusts
	download_issuer_trusts
	generate_certificate
	update_trusts
	finalize_java_variables
	relax_permissions

	# Close it all up!
	export RESULT_OK="true"
	as_boolean "${FIPS}" && FIPS_LABEL=" (FIPS is active)" || FIPS_LABEL=""
	ok "SSL ready! The environment can be configured by sourcing [${SSL_ENV_FILE}]${FIPS_LABEL}"
) 999<"${LOCK}"
